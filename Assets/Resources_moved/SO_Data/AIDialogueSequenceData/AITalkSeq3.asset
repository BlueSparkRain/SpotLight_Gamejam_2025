  ID: 3
  canAutonNext: 0
  canQuickShow: 1
  needTyping: 1
  currentIndex: 0
  fadeDuration: 0
  eventList: []
  dialogueLine:
  - speaker: 0
    content: "\u2026\u2026\u6CA1\u9519\uFF0C\u5404\u4F4D\u3010\u89C2\u4F17\u3011\uFF0C\u805A\u5149\u706F\u524D\u5929\u8863\u65E0\u7F1D\u7684\u4F2A\u5584\u8005\u3001\u8868\u6F14\u8005\u5C06\u5728\u8FD9\u91CC\u88AB\u62C9\u4E0B\u795E\u575B\u2014\u2014\n\u6211\u4EEC\u6252\u5F00\u865A\u5047\u7684\u76AE\u56CA\uFF0C\u627E\u5230\u4ED6\u4EEC\u9690\u85CF\u5728\u4E92\u8054\u7F51\u6700\u6DF1\u5904\u89D2\u843D\u7684\u7F6A\u884C\uFF01\r\n"
  - speaker: 1
    content: "\u8FC7\u591A\u7684\u5F39\u5E55\u4F1A\u59A8\u788D\u64CD\u4F5C\u533A\u3002\u6211\u4F1A\u5229\u7528Aura\u603B\u7ED3\u5F39\u5E55\u5185\u5BB9\uFF0C\u5E76\u4E0E\u8BF8\u4F4D\u4EA4\u6D41\u3002\r\n"
  - speaker: 0
    content: "\u6BD4\u5982\u73B0\u5728\uFF0C\u89C2\u4F17\u4EEC\u8BF4\u2014\u2014\u4E3B\u4EBA\u60A8\u5728\u76F4\u64AD\u201C\u5F00\u76D2\u201D\u5462\uFF01\r\n"
  - speaker: 1
    content: "\"\u201C\u5F00\u76D2\u201D\u5417\u2026\u2026\u4E0D\uFF0C\u66F4\u51C6\u786E\u7684\u8FC7\u7A0B\u662F\u5BA1\u5224\u201D\u4E0E\u201C\u63ED\u9732\u201D\u3002\n\u4F7F\u7528\u7684\u6807\u51C6\u4F9D\u65E7\u4F1A\u7ED3\u5408\u666E\u4E16\u9053\u5FB7\u3001\u6CD5\u5F8B\uFF0C\u91C7\u7528Aura\u7684\u8FD0\u7B97\u91CF\u5316\u8BC4\u5B9A\u3002\"\r\n"
  - speaker: 0
    content: "\u5594\u2026\u2026\u56FA\u5B9A\u8282\u76EE\uFF01\u6211\u5C31\u77E5\u9053\uFF0C\u6BCF\u4E00\u6B21\u5F00\u64AD\u90FD\u514D\u4E0D\u4E86\u8FD9\u4E00\u906D\u5BF9\u201C\u516C\u6B63\u6027\u201D\u7684\u8D28\u7591\uFF01\r\n"
  - speaker: 1
    content: "\u2026\u2026 "
  - speaker: 0
    content: "\u65E0\u8BBA\u5982\u4F55\u7CBE\u7EC6\u7684\u91CF\u5316\u90FD\u4F1A\u62DB\u6765\u865A\u65E0\u4E3B\u4E49\u8005\u7684\u8D28\u7591\u3002\u5BF9\u4EBA\u7C7B\u800C\u8A00\uFF0C\u4EFB\u4F55\u7CBE\u7EC6\u7684\u91CF\u5316\u8BC4\u4F30\u90FD\u96BE\u4EE5\u5B8C\u5168\u89C4\u907F\u4E3B\u89C2\u7684\u5E72\u6270\uFF0C\r"
  - speaker: 0
    content: "\u53EF\u6211\u7684\u9053\u5FB7\u5224\u5B9A\u6A21\u578B\u5EFA\u7ACB\u5728\u6570\u5341\u4EBF\u6570\u636E\u70B9\u7684\u8BAD\u7EC3\u4E4B\u4E0A\uFF0C\u5176\u6838\u5FC3\u903B\u8F91\u662F\u7A33\u56FA\u4E14\u4E0D\u53EF\u7BE1\u6539\u7684\u3002"
