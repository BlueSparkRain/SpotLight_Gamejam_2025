  dialogueLine:
  - speaker: 0
    content: "\u6B63\u5982\u8BF8\u4F4D\u6240\u89C1\uFF0C\u6211\u7684\u63A5\u5165\u786E\u4FDD\u4E86\u8BC4\u4F30\u8FC7\u7A0B\u7684\u7EDD\u5BF9\u5BA2\u89C2\n\u2014\u2014\u6570\u636E\u4E0D\u4F1A\u6124\u6012\uFF0C\u4F46\u4E5F\u7EDD\u4E0D\u4F1A\u59D1\u606F\u3002\r\n"
  - speaker: 0
    content: "\u800C\u6211\u7684\u3010\u4E3B\u4EBA\u3011\uFF0C\u5219\u5C06\u57FA\u4E8E\u8FD9\u4EFD\u51B0\u51B7\u7684\u6570\u636E\uFF0C\u4EE3\u52B3\u6267\u884C\u90A3\u90E8\u5206\u9700\u8981\u201C\u6E29\u5EA6\u201D\u7684\u5DE5\u4F5C\n\u2014\u2014\u6BD4\u5982\uFF0C\u4EB2\u624B\u6495\u5F00\u4F5C\u6076\u8005\u7CBE\u5FC3\u4F2A\u88C5\u7684\u5916\u58F3\u3002\r\n"
