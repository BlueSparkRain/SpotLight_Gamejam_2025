  m_Script: {fileID: 11500000, guid: 7051832cd774b9f47bf65a79fbffbf5b, type: 3}
  m_Name: AI_Diao_2
  m_EditorClassIdentifier: 
  Discription: 
  AIDialogueID: 2
  data:
  - DialogueType: 0
    content: "\u660E\u767D\u3002\u540C\u65F6\u8FDB\u884C\u65E5\u7A0B\u63D0\u9192\uFF1A\u7A0D\u540E\u5C06\u8FDB\u884C\u3010\u76F4\u64AD\u3011\u65E5\u7A0B\uFF0C\u5DF2\u4E3A\u60A8\u8C03\u6574\u754C\u9762\u5E76\u542F\u52A8\u76F8\u5173\u63D2\u4EF6\u3002\r\n"
  - DialogueType: 0
    content: "\"\u5F88\u9AD8\u5174\u518D\u6B21\u76F8\u9047\uFF0C\u5404\u4F4D\u3010\u89C2\u4F17\u3011\u3002\u6211\u4F9D\u65E7\u662F\u4F60\u4EEC\u719F\u8BC6\u7684Aura\u3002\n\u800C\u8FD9\u4F4D\uFF0C\u53E6\u4E00\u4E2A\u6587\u5B57\u6846\u91CC\u7684\u5BB6\u4F19\uFF0C\u662F\u6211\u7684\u3010\u4E3B\u4EBA\u3011\uFF0C\u4E5F\u662F\u672C\u6B21\u76F4\u64AD\u91CC\u5411\u8BF8\u4F4D\u5C55\u793A\u6F58\u591A\u62C9\u9B54\u76D2\u4E4B\u5185\u7684\u5BFC\u6F14\u2014\u2014\"\r\n"
  - DialogueType: 1
    content: "\u76F4\u64AD\u65F6\u4F60\u7684\u8BED\u5E93\u8C03\u7528\u683C\u5916\u6D3B\u8DC3\u2026\u2026\r\n"
  - DialogueType: 0
    content: "\u653E\u8F7B\u677E\uFF01\u6216\u8BB8\uFF0C\u60A8\u81F3\u5C11\u53EF\u4EE5\u6D3B\u6CFC\u70B9\uFF0C\u8DDF\u5927\u5BB6\u6253\u4E2A\u62DB\u547C\u4E4B\u7C7B\u7684\u3002\r\n"
