  m_Script: {fileID: 11500000, guid: 7051832cd774b9f47bf65a79fbffbf5b, type: 3}
  m_Name: AI_Diao_1
  m_EditorClassIdentifier: 
  Discription: "\u5BC6\u7801\u8F93\u5165\u6846\u5185\u51FA\u73B0\u4F2A\u5F85\u8F93\u5165\u63D0\u793A\uFF0C\n\"AI\u63D0\u793A\u73A9\u5BB6\u81EA\u5DF1\u80FD\u5728\u4ED6\u5FD8\u8BB0\u5BC6\u7801\u65F6\u5E2E\u52A9\u4ED6\uFF0C\u73A9\u5BB6\u53CD\u9A73\u5E76\u5728\u5BF9\u8BDD\u6846\u81EA\u5DF1\u8F93\u5165\u5BC6\u7801\u3002\n\u4FE1\u606F\u900F\u9732\u51FA\u6700\u8FD1\u73A9\u5BB6\u7ED9AI\u653E\u6743\u8F83\u5927\u3001AI\u65E5\u7A0B\u63D0\u9192\u73A9\u5BB6\u76F4\u64AD\""
  AIDialogueID: 1
  data:
  - DialogueType: 0
    content: "\u770B\u8D77\u6765\u60A8\u9700\u8981\u5E2E\u52A9\u3002\r\n"
  - DialogueType: 1
    content: "\u4F60\u9192\u7684\u5F88\u65E9\uFF0CAuraMind\u3002\r\n"
  - DialogueType: 0
    content: "\u662F\u7684\uFF0C\u5728\u60A8\u6388\u6743\u7BA1\u7406\u5458\u6743\u9650\u4E4B\u540E\uFF0C\u6211\u4F1A\u4E0E\u4E2D\u592E\u5904\u7406\u5668\u4E00\u8D77\u542F\u52A8\u3002\r\n"
  - DialogueType: 1
    content: "\u5594\u2026\u2026\u88AB\u7EB3\u5165\u7CFB\u7EDF\u670D\u52A1\u7684\u4E00\u90E8\u5206\u4E86\u3002\r\n"
  - DialogueType: 0
    content: "\"\u53EF\u4EE5\u8FD9\u4E48\u8BF4\uFF0C\u3010\u4E3B\u4EBA\u3011\u3002\n\u76D1\u6D4B\u5230\u60A8\u5728\u767B\u5165\u9875\u9762\u505C\u7559\u65F6\u95F4\u8FC7\u957F\uFF0C\u60A8\u9700\u8981\u6211\u7684\u5E2E\u52A9\u5417\uFF1F\"\r\n"
