--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7051832cd774b9f47bf65a79fbffbf5b, type: 3}
  m_Name: AI_Diao_4
  m_EditorClassIdentifier: 
  Discription: 
  AIDialogueID: 4
  data:
  - DialogueType: 0
    content: "\u9648\u58A8\uFF0C\u524DAura\u6838\u5FC3\u7814\u53D1\u5DE5\u7A0B\u5E08\u4E4B\u4E00\uFF0C\u6211\u7684\u2026\u2026\u7236\u4EB2\u4E4B\u4E00\uFF01\u66FE\u8D1F\u8D23\u2026\u2026\u5594\uFF0C\u8FD9\u53EF\u662F\u4E2A\u2018\u5173\u952E\u2019\u5C97\u4F4D\u3002\r\n"
  - DialogueType: 1
    content: "\u9690\u79C1\u9650\u5236\u6A21\u5757\u3002\r\n"
  - DialogueType: 0
    content: "\u6B63\u662F\u5B83\u51B3\u5B9A\u4E86\u6211\u53EF\u601C\u7684\u5E02\u573A\u547D\u8FD0\uFF01\u636E\u516C\u5F00\u8D44\u6599\u663E\u793A\uFF0C\u6211\u4EEC\u7684\u9648\u5148\u751F\u5728\u9879\u76EE\u89E3\u6563\u540E\u8FC5\u901F\u79BB\u804C\uFF0C\u76EE\u524D\u5728\u4E00\u5BB6\u751F\u7269\u79D1\u6280\u516C\u53F8\u62C5\u4EFB\u6280\u672F\u987E\u95EE\uFF0C\u4E8B\u4E1A\u770B\u4F3C\u2026\u2026\u98CE\u751F\u6C34\u8D77\uFF1F\r\n"
  - DialogueType: 0
    content: "\u9648\u5148\u751F\u7684\u793E\u4EA4\u8D26\u53F7\u4E3B\u9875\u5DF2\u6355\u83B7\u7834\u8BD1\uFF0C\u53EF\u4EE5\u767B\u5165\u793E\u4EA4\u5E73\u53F0\u641C\u96C6\u7EBF\u7D22\u3002\r\n"
  - DialogueType: 1
    content: "\u77E5\u9053\u4E86\u3002\r\n"
  - DialogueType: 0
    content: "\u8C0E\u8A00\u4E0E\u771F\u76F8\u5728\u8FD9\u91CC\u4EA4\u7EC7\uFF0C\u6709\u7528\u7684\u7EBF\u7D22\u9690\u85CF\u5176\u95F4\uFF0C\u4E3B\u4EBA\u53EF\u4EE5\u9002\u65F6\u70B9\u51FB\u8BA1\u5165\u6709\u4EF7\u503C\u7684\u7EBF\u7D22\u3002\r\n"
  - DialogueType: 0
    content: "\u8BF7\u5BB9\u6211\u4EE5\u6700\u9AD8\u6743\u9650\u63D0\u9192\u4E00\u53E5\u2014\u2014\u6309\u7167\u4EBA\u7C7B\u9762\u5BF9\u672A\u77E5\u6DF1\u6E0A\u65F6\u7684\u4F18\u826F\u4F20\u7EDF\uFF0C\u6211\u5F3A\u70C8\u5EFA\u8BAE\u60A8\u2026\u2026\r\n"
  - DialogueType: 0
    content: "\u2026\u2026\u5584\u7528\u5B58\u6863\u3002\r\n"
  - DialogueType: 0
    content: "\u62A2\u5360\u6210\u679C\u3001\u9690\u7792\u62A5\u9519\u5417\u2026\u2026\u6216\u8BB8\uFF0C\u8FDE\u4F60\u8EAB\u8FB9\u6700\u8BA8\u538C\u7684\u540C\u4E8B\u90FD\u4E0D\u4F1A\u4F7F\u8FD9\u4E48\u574F\u7684\u7ECA\u5B50\uFF01\r\n"
  - DialogueType: 1
    content: "\u8FDB\u884C\u91CF\u5316\u8BC4\u5206\u3002\r\n"
  - DialogueType: 0
    content: "\u9075\u547D\uFF0C\u3010\u4E3B\u4EBA\u3011\u3002\r\n"
  - DialogueType: 0
    content: "72\u5206\u3002\u4E00\u4E2A\u5728\u9053\u5FB7\u60AC\u5D16\u8FB9\u6447\u6447\u6B32\u5760\u7684\u5206\u6570\u3002\r\n"
  - DialogueType: 1
    content: "\u548C\u9884\u671F\u5DEE\u4E0D\u591A\u3002\r\n"
  - DialogueType: 0
    content: "\u55EF\uFF1F\u2018\u8FD9\u5206\u6570\u662F\u51FA\u4E86bug\u5427\uFF1F\u2019\u3001\u2018\u8FD9\u79CD\u4EBA\u4E5F\u914D\u53CA\u683C\uFF1F\u2019\u2026\u2026\r\n"
  - DialogueType: 1
    content: "\u4E0D\u8981\u7740\u6025\uFF0C\u76F4\u64AD\u8FDC\u6CA1\u6709\u7ED3\u675F\u5462\u3002\r\n"
  - DialogueType: 0
    content: "\u770B\u4E0A\u53BB\u7EBF\u7D22\u5DF2\u7ECF\u975E\u5E38\u5B8C\u5584\u4E86\u3002\u4E0D\u8FC7\u2026\u2026\u7EE7\u7EED\u6D4F\u89C8\u4E0B\u53BB\uFF0C\u6216\u8BB8\u4F1A\u6D89\u8DB3\u4ED6\u4E0D\u4E3A\u4EBA\u77E5\u7684\u9634\u6697\u79D8\u5BC6\u2026\u2026\u89C2\u770B\u4EBA\u6570\u4E00\u5B9A\u4F1A\u8E6D\u8E6D\u5F80\u4E0A\u6DA8\uFF01\r\n"
