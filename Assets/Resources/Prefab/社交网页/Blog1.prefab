      value: "\"\u3010\u56FE\u7247-\u5165\u804C2\u5468\u5E74\u7EAA\u5FF5\u76D2\u3011\n\u8FD9\u6761\u957F\u8857\u7684\u7B2C\u4E8C\u4E2A\u79CB\u5929\u3002\u6CA1\u6709\u653E\u5047\uFF0C\u6253\u5361\u673A\u6309\u65F6\u6EF4\u4E00\u58F0\uFF0C\u50CF\u5F80\u65F6\u95F4\u6CB3\u91CC\u53C8\u6295\u4E86\u679A\u77F3\u5B50\u3002\n\u63A5\u5230\u5408\u4F5C\u90AE\u4EF6\u7684\u90A3\u5929\uFF0C\u533B\u9662\u8D70\u5ECA\u7684\u6D88\u6BD2\u6C34\u5473\u8FD8\u9ECF\u5728\u5916\u5957\u4E0A\uFF0C\u8D26\u5355\u6298\u5728\u5305\u91CC\uFF0C\u6BCF\u4E2A\u6570\u5B57\u90FD\u784C\u4EBA\u3002\n\u6709\u70B9\u4E71\u7CDF\u7CDF\u7684\u2026\u2026\u4F46\u90A3\u5929\u4EE5\u4E3A\u8981\u8C08\u8BD5\u7528\u671F\uFF0C\u624B\u91CC\u6525\u7740\u6C57\u3002\u5979\u5374\u63A8\u8FC7\u90A3\u4EFD\u5408\u540C\u2014\u2014\u8FD8\u6709\u9879\u76EE\u5956\u91D1\uFF0C\u6B63\u597D\u8986\u76D6\u6389\u90A3\u4E2A\u6708\u7684\u8D39\u7528\u3002\n\u5DE5\u4F4D\u5916\u7684\u94F6\u674F\u9EC4\u4E86\u53C8\u7EFF\uFF0C\u7EFF\u4E86\u53C8\u9EC4\u3002\u611F\u8C22\u8FD9\u91CC\uFF0C\u8BA9\u6211\u5728\u81F3\u6697\u65F6\u523B\u80FD\u4F53\u9762\u5730\u7AD9\u7740\uFF0C\u63A5\u4F4F\u4E86\u4EBA\u751F\u6700\u91CD\u7684\u4E00\u6B21\u4E0B\u5760\u3002\n\u7EE7\u7EED\u5F80\u524D\u8D70\u5427\u3002\""
